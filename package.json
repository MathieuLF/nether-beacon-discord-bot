{
  "name": "nether-beacon",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "description": "Self-hosted Discord administration and isolated music stack",
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node --watch bot.js",
    "syntax": "node scripts/check-syntax.js",
    "start": "node bot.js",
    "healthcheck": "node healthcheck.js",
    "validate:config": "node scripts/validate-config.js",
    "verify:pokedex": "node scripts/verify-pokedex-live.js",
    "capture:ids": "node scripts/capture-managed-ids.js",
    "test": "node --test",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "build:site": "node scripts/build-public-site.js",
    "init:local": "node scripts/init-local.js",
    "check:dev": "node scripts/check-dev.js",
    "check:containers": "node scripts/check-containers.js",
    "check:release": "npm run check && npm audit --omit=dev --audit-level=high && npm run check:containers -- --scan",
    "check": "npm run check:dev"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2"
  },
  "overrides": {
    "undici": "6.28.1",
    "fast-uri": "3.1.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2"
}
